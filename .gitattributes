# Konzistentní konce řádků napříč platformami — text LF, binárky beze změny.
* text=auto eol=lf

*.php   text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.svg   text eol=lf
*.xml   text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
.htaccess text eol=lf

# binární soubory — git je nemá normalizovat
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
